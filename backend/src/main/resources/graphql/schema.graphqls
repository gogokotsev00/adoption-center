enum DogStatus {
    AVAILABLE
    PENDING
    ADOPTED
}

enum ApplicationStatus {
    PENDING
    APPROVED
    REJECTED
}

enum NotificationEventType {
    DOG_PURCHASE_COMPLETED
}

type Dog {
    id: ID!
    name: String!
    age: Int!
    fee: Float!
    status: DogStatus!
    owner: Owner
}

type Owner {
    id: ID!
    name: String!
    money: Float!
}

type AdoptionApplication {
    id: ID!
    owner: Owner!
    dog: Dog!
    status: ApplicationStatus!
    createdAt: String
}

type Notification {
    id: ID!
    owner: Owner!
    eventType: NotificationEventType!
    message: String!
    read: Boolean!
    createdAt: String
}

type Query {
    dogs: [Dog]
    dogById(id: ID!): Dog
    dogsByOwnerId(ownerId: ID!): [Dog]
    owners: [Owner]
    ownerById(id: ID!): Owner
    applications: [AdoptionApplication]
    applicationById(id: ID!): AdoptionApplication
    applicationsByOwnerId(ownerId: ID!): [AdoptionApplication]
    notifications: [Notification]
    notificationsByOwnerId(ownerId: ID!): [Notification]
}

type Mutation {
    createDog(name: String!, age: Int!, fee: Float, status: DogStatus): Dog!
    createOwner(name: String!, money: Float!): Owner!
    deleteOwnerById(id: ID!): Int!
    updateOwnerMoney(id: ID!): Owner!
    createAdoptionApplication(ownerId: ID!, dogId: ID!): AdoptionApplication!
    approveAdoptionApplication(id: ID!): AdoptionApplication!
    rejectAdoptionApplication(id: ID!): AdoptionApplication!
    markNotificationAsRead(id: ID!): Notification!
    markAllNotificationsAsRead(ownerId: ID!): [Notification]!
}
